{
    "name": "Dark",
    "version": 1,
    "background": { "color": "#1A1A2E" },
    "render_order": ["land","water_polygons","water_lines","sites","buildings","streets","bridges"],
    "label_order": ["street_labels","place_labels","pois"],
    "layers": {
        "water_polygons": { "fill": { "color": "#16213E" } },
        "water_lines": { "stroke": { "color": "#16213E", "width": 1.5 } },
        "buildings": { "fill": { "color": "#2A2A3E" } },
        "sites": { "fill": { "color": "#222238", "opacity": 0.5 } },
        "streets": {
            "stroke": {
                "default": { "color": "#3A3A5E", "width": 1.0 },
                "match": { "key": "kind", "values": {
                    "motorway": { "color": "#E94560", "width": 3.0 },
                    "trunk": { "color": "#E94560", "width": 3.0 },
                    "primary": { "color": "#C73E54", "width": 2.5 },
                    "secondary": { "color": "#4A4A6E", "width": 2.0 },
                    "tertiary": { "color": "#4A4A6E", "width": 2.0 },
                    "residential": { "color": "#3A3A5E", "width": 1.2 },
                    "service": { "color": "#2A2A4E", "width": 0.8 },
                    "path": { "color": "#2A2A4E", "width": 0.8 }
                }}
            }
        },
        "bridges": {
            "stroke": {
                "default": { "color": "#4A4A6E", "width": 1.5 },
                "match": { "key": "kind", "values": {
                    "motorway": { "color": "#E94560", "width": 3.0 }
                }}
            }
        },
        "land": {
            "fill": {
                "default": { "opacity": 0 },
                "match": { "key": "kind", "values": {
                    "park": { "color": "#1B3A2D" },
                    "garden": { "color": "#1B3A2D" },
                    "forest": { "color": "#1B3A2D" },
                    "hospital": { "color": "#3A1A2E" },
                    "school": { "color": "#2E2A1A" },
                    "residential": { "color": "#1E1E30" },
                    "commercial": { "color": "#2E1A1A" },
                    "industrial": { "color": "#2A1E2E" }
                }}
            }
        },
        "pois": {
            "show": { "min_zoom": 14 },
            "label": {
                "color": "#AAAACC",
                "icons": { "key": "kind", "values": {
                    "restaurant": "\uF2E7",
                    "cafe": "\uF0F4",
                    "hospital": "\uF0F8",
                    "school": "\uF549",
                    "hotel": "\uF594",
                    "bank": "\uF19C",
                    "bus_stop": "\uF207",
                    "default": "\uF3C5"
                }}
            }
        },
        "street_labels": {
            "label": { "color": "#8888AA" }
        },
        "place_labels": {
            "label": { "color": "#AAAACC" }
        }
    }
}
